---
import { useTranslations } from "../i18n/utils.ts";

interface Props {
	lang: "es" | "en";
}

const { lang } = Astro.props;
const t = useTranslations(lang);
---

<section class="mx-auto flex w-full max-w-6xl flex-col items-center px-6 py-20 text-center sm:py-28">
	<p
		class="mb-4 inline-flex items-center rounded-full border border-orange-200 bg-orange-50 px-4 py-1 text-xs font-semibold uppercase tracking-widest text-orange-700"
	>
		{t("hero.kicker")}
	</p>
	<h1 class="max-w-3xl text-4xl font-bold leading-tight tracking-tight text-stone-900 sm:text-5xl">
		{t("hero.title")}
	</h1>
	<p class="mt-6 max-w-2xl text-lg leading-relaxed text-stone-600">
		{t("hero.subtitle")}
	</p>
	<div class="mt-10 flex flex-col items-center gap-4 sm:flex-row">
		<a
			href="#menu"
			class="inline-flex items-center justify-center rounded-full bg-orange-600 px-8 py-3 text-sm font-semibold text-white shadow-lg shadow-orange-600/20 transition hover:bg-orange-700"
		>
			{t("hero.primaryCta")}
		</a>
		<a
			href="#info"
			class="inline-flex items-center justify-center rounded-full border border-stone-300 bg-white px-8 py-3 text-sm font-semibold text-stone-900 transition hover:border-stone-400 hover:bg-stone-50"
		>
			{t("hero.secondaryCta")}
		</a>
	</div>
</section>
