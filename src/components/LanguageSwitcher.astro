---
import { getRelativeLocaleUrl } from "astro:i18n";
import { useTranslations } from "../i18n/utils.ts";

interface Props {
	lang: "es" | "en";
}

const { lang } = Astro.props;
const t = useTranslations(lang);

const esUrl = getRelativeLocaleUrl("es", "/");
const enUrl = getRelativeLocaleUrl("en", "/");

const baseClasses =
	"rounded-full px-2.5 py-1 text-[11px] font-semibold uppercase tracking-wider transition focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-stone-900";
const activeClasses = "bg-stone-900 text-white";
const inactiveClasses = "text-stone-500 hover:bg-stone-100 hover:text-stone-900";
---

<nav
	aria-label={t("langSwitcher.label")}
	class="inline-flex items-center gap-0.5 rounded-full border border-stone-200 bg-white p-0.5"
>
	<a
		href={esUrl}
		aria-current={lang === "es" ? "page" : undefined}
		class:list={[baseClasses, lang === "es" ? activeClasses : inactiveClasses]}
	>
		ES
	</a>
	<a
		href={enUrl}
		aria-current={lang === "en" ? "page" : undefined}
		class:list={[baseClasses, lang === "en" ? activeClasses : inactiveClasses]}
	>
		EN
	</a>
</nav>
