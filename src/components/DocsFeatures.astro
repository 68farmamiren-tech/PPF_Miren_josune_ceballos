---
import { ui } from "../i18n/ui.ts";
import { useTranslations } from "../i18n/utils.ts";

interface Props {
	lang: "es" | "en";
}

const { lang } = Astro.props;
const t = useTranslations(lang);
const cards = ui[lang].sections.docs.cards;
---

<section id="docs" aria-labelledby="docs-heading" class="scroll-mt-24 bg-white">
	<div class="mx-auto max-w-6xl px-6 py-20 sm:py-24 lg:py-28">
	<h2 id="docs-heading" class="text-balance text-3xl font-extrabold tracking-tight text-stone-950 sm:text-4xl lg:text-[2.75rem] lg:leading-[1.1]">
		{t("sections.docs.title")}
	</h2>
	<p class="mt-5 max-w-2xl text-base leading-relaxed text-stone-600 sm:text-lg">
		{t("sections.docs.subtitle")}
	</p>
	<div class="mt-10 grid gap-6 md:grid-cols-2 lg:grid-cols-3 lg:gap-8">
		{cards.map((card, index) => (
			<article class="group flex flex-col rounded-3xl border border-stone-900/10 bg-white p-6 transition duration-300 hover:-translate-y-1 hover:border-stone-900/20 hover:shadow-xl hover:shadow-stone-950/[0.07] focus-within:-translate-y-1 focus-within:border-stone-900/20 focus-within:shadow-xl focus-within:shadow-stone-950/[0.07] sm:p-7">
				{index % 3 === 0 && (
					<span
						aria-hidden="true"
						class="flex h-11 w-11 items-center justify-center rounded-full bg-orange-100 transition group-hover:bg-orange-200"
					>
						<span class="h-3.5 w-3.5 rounded-full bg-orange-600"></span>
					</span>
				)}
				{index % 3 === 1 && (
					<span
						aria-hidden="true"
						class="flex h-11 w-11 items-center justify-center rounded-2xl bg-amber-100 transition group-hover:bg-amber-200"
					>
						<span class="h-4 w-4 rounded-[4px] bg-amber-600"></span>
					</span>
				)}
				{index % 3 === 2 && (
					<span
						aria-hidden="true"
						class="flex h-11 w-11 items-center justify-center rounded-2xl bg-stone-100 transition group-hover:bg-stone-200"
					>
						<span class="h-0 w-0 border-x-[9px] border-b-[15px] border-x-transparent border-b-stone-800"></span>
					</span>
				)}
				<h3 class="mt-5 text-lg font-semibold tracking-tight text-stone-900">{card.title}</h3>
				<p class="mt-2 flex-1 text-sm leading-relaxed text-stone-600">{card.text}</p>
				<a
					href="#docs"
					class="mt-3 inline-flex w-fit items-center gap-1 py-1 text-sm font-semibold text-orange-700 transition hover:gap-2 hover:text-orange-800 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-orange-700"
				>
					{card.link}
					<span aria-hidden="true">→</span>
				</a>
			</article>
		))}
	</div>
	</div>
</section>
