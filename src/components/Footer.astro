---
import { getRelativeLocaleUrl } from "astro:i18n";
import { ui } from "../i18n/ui.ts";

interface Props {
	lang: "es" | "en";
}

const { lang } = Astro.props;
const footer = ui[lang].footer;
const homeUrl = getRelativeLocaleUrl(lang, "/");

const infoHrefs = [homeUrl, "#info", "#deals", `mailto:${footer.email}`];
---

<footer class="bg-stone-950 text-stone-300">
	<div class="mx-auto grid max-w-6xl gap-10 px-6 py-16 md:grid-cols-2 lg:grid-cols-4">
		<div>
			<a href={homeUrl} class="flex items-center gap-2.5">
				<span
					aria-hidden="true"
					class="flex h-9 w-9 shrink-0 items-center justify-center rounded-full bg-orange-600 font-serif text-lg font-bold text-white"
				>
					C
				</span>
				<span class="text-[15px] font-extrabold tracking-tight text-white">
					Casa Tomate
				</span>
			</a>
			<p class="mt-4 text-sm leading-relaxed text-stone-400">{footer.tagline}</p>
			<address class="mt-4 flex flex-col gap-0 text-sm not-italic text-stone-400">
				<span class="py-1">{footer.address}</span>
				<a href={`mailto:${footer.email}`} class="inline-block py-1 transition hover:text-amber-300 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-amber-300">
					{footer.email}
				</a>
				<a href={`tel:${footer.phone.replace(/\s/g, "")}`} class="inline-block py-1 transition hover:text-amber-300 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-amber-300">
					{footer.phone}
				</a>
			</address>
		</div>
		<nav aria-label={footer.infoTitle}>
			<h2 class="text-xs font-bold uppercase tracking-[0.18em] text-white">
				{footer.infoTitle}
			</h2>
			<ul class="mt-3 flex flex-col gap-0.5">
				{footer.infoLinks.map((link, index) => (
					<li>
						<a href={infoHrefs[index] ?? homeUrl} class="inline-block py-1 text-sm text-stone-400 transition hover:text-amber-300 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-amber-300">
							{link}
						</a>
					</li>
				))}
			</ul>
		</nav>
		<nav aria-label={footer.foodTitle}>
			<h2 class="text-xs font-bold uppercase tracking-[0.18em] text-white">
				{footer.foodTitle}
			</h2>
			<ul class="mt-3 flex flex-col gap-0.5">
				{footer.foodLinks.map((link) => (
					<li>
						<a href="#menu" class="inline-block py-1 text-sm text-stone-400 transition hover:text-amber-300 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-amber-300">
							{link}
						</a>
					</li>
				))}
			</ul>
		</nav>
		<div>
			<h2 class="text-xs font-bold uppercase tracking-[0.18em] text-white">
				{footer.hoursTitle}
			</h2>
			<ul class="mt-4 flex flex-col gap-2">
				{footer.hours.map((row) => (
					<li class="flex items-center justify-between gap-4 text-sm text-stone-400">
						<span class="font-semibold text-stone-200">{row.day}</span>
						<span>{row.time}</span>
					</li>
				))}
			</ul>
		</div>
	</div>
	<div class="border-t border-white/10">
		<p class="mx-auto max-w-6xl px-6 py-6 text-xs text-stone-400">
			{footer.copyright}
		</p>
	</div>
</footer>
