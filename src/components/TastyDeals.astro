---
import { ui } from "../i18n/ui.ts";
import { useTranslations } from "../i18n/utils.ts";

interface Props {
	lang: "es" | "en";
}

interface Offer {
	title: string;
	description: string;
	price: string;
	schedule: string;
}

const { lang } = Astro.props;
const t = useTranslations(lang);

const offers: Offer[] = ui[lang].deals.items.map((item) => ({
	title: item.title,
	description: item.promo,
	price: item.price,
	schedule: item.schedule,
}));
---

<section id="deals" aria-labelledby="deals-heading" class="scroll-mt-24 bg-white">
	<div class="mx-auto max-w-6xl px-6 py-20 sm:py-24 lg:py-28">
	<h2 id="deals-heading" class="text-balance text-3xl font-extrabold tracking-tight text-stone-950 sm:text-4xl lg:text-[2.75rem] lg:leading-[1.1]">
		{t("deals.title")}
	</h2>
	<p class="mt-5 max-w-2xl text-base leading-relaxed text-stone-600 sm:text-lg">
		{t("deals.subtitle")}
	</p>
	<div class="mt-10 grid gap-6 md:grid-cols-3 lg:gap-8">
		{offers.map((offer) => (
			<article class="flex flex-col rounded-3xl border border-stone-900/10 bg-cream p-6 transition duration-300 hover:-translate-y-1 hover:border-stone-900/20 hover:shadow-xl hover:shadow-stone-950/[0.07] sm:p-7">
				<div class="flex flex-wrap items-center justify-between gap-x-3 gap-y-2">
					<p class="text-xs font-semibold uppercase tracking-widest text-stone-600">
						{offer.schedule}
					</p>
					<p class="shrink-0 rounded-full bg-stone-950 px-4 py-1.5 text-lg font-extrabold tracking-tight text-amber-300">
						{offer.price}
					</p>
				</div>
				<h3 class="mt-4 text-lg font-bold tracking-tight text-stone-900">{offer.title}</h3>
				<p class="mt-2 flex-1 text-sm leading-relaxed text-stone-600">{offer.description}</p>
			</article>
		))}
	</div>
	</div>
</section>
