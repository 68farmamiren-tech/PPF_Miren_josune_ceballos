---
import { getRelativeLocaleUrl } from "astro:i18n";
import LanguageSwitcher from "./LanguageSwitcher.astro";
import { useTranslations } from "../i18n/utils.ts";

interface Props {
	lang: "es" | "en";
}

const { lang } = Astro.props;
const t = useTranslations(lang);

const homeUrl = getRelativeLocaleUrl(lang, "/");
---

<header class="sticky top-3 z-50 px-4 sm:px-6">
	<div
		class="mx-auto flex max-w-6xl items-center justify-between gap-3 rounded-2xl border border-stone-200/80 bg-white/85 py-3 pl-4 pr-3 shadow-lg shadow-stone-900/5 backdrop-blur-md sm:pl-5 sm:pr-4"
	>
		<a
			href={homeUrl}
			class="flex min-w-0 items-center gap-2.5 rounded-xl transition focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-stone-900"
			aria-label="Casa Tomate"
		>
			<span
				aria-hidden="true"
				class="flex h-9 w-9 shrink-0 items-center justify-center rounded-full bg-orange-600 font-serif text-lg font-bold text-white"
			>
				C
			</span>
			<span class="truncate text-[15px] font-extrabold tracking-tight text-stone-950">
				Casa Tomate
			</span>
		</a>

		<nav aria-label={t("nav.main")} class="hidden items-center gap-1 md:flex">
			<a
				href={homeUrl}
				class="rounded-full px-3 py-2 text-sm font-semibold text-stone-600 transition hover:bg-stone-100 hover:text-stone-950 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-stone-900 lg:px-4"
			>
				{t("nav.home")}
			</a>
			<a
				href="#info"
				class="rounded-full px-3 py-2 text-sm font-semibold text-stone-600 transition hover:bg-stone-100 hover:text-stone-950 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-stone-900 lg:px-4"
			>
				{t("nav.about")}
			</a>
			<a
				href="#menu"
				class="rounded-full px-3 py-2 text-sm font-semibold text-stone-600 transition hover:bg-stone-100 hover:text-stone-950 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-stone-900 lg:px-4"
			>
				{t("nav.menu")}
			</a>
			<span aria-hidden="true" class="mx-2 h-5 w-px bg-stone-200"></span>
			<LanguageSwitcher lang={lang} />
			<a
				href="#menu"
				class="ml-2 rounded-full bg-stone-950 px-4 py-2 text-sm font-semibold text-white transition hover:bg-orange-700 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-stone-900"
			>
				{t("nav.reserve")}
			</a>
		</nav>

		<details class="relative shrink-0 md:hidden">
			<summary
				class="inline-flex cursor-pointer list-none items-center justify-center rounded-full border border-stone-300 p-2.5 text-stone-800 transition hover:border-stone-400 hover:bg-stone-100 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-stone-900 [&::-webkit-details-marker]:hidden"
			>
				<span class="sr-only">{t("nav.openMenu")}</span>
				<svg
					xmlns="http://www.w3.org/2000/svg"
					width="20"
					height="20"
					viewBox="0 0 24 24"
					fill="none"
					stroke="currentColor"
					stroke-width="2"
					stroke-linecap="round"
					stroke-linejoin="round"
					aria-hidden="true"
				>
					<line x1="4" x2="20" y1="6" y2="6"></line>
					<line x1="4" x2="20" y1="12" y2="12"></line>
					<line x1="4" x2="20" y1="18" y2="18"></line>
				</svg>
			</summary>
			<div
				class="absolute right-0 top-full z-50 mt-2 flex w-60 max-w-[calc(100vw-3rem)] flex-col gap-1 rounded-2xl border border-stone-200 bg-white p-3 shadow-xl shadow-stone-900/10"
			>
				<a
					href={homeUrl}
					class="rounded-xl px-3 py-2.5 text-sm font-semibold text-stone-700 transition hover:bg-stone-100 hover:text-stone-950"
				>
					{t("nav.home")}
				</a>
				<a
					href="#info"
					class="rounded-xl px-3 py-2.5 text-sm font-semibold text-stone-700 transition hover:bg-stone-100 hover:text-stone-950"
				>
					{t("nav.about")}
				</a>
				<a
					href="#menu"
					class="rounded-xl px-3 py-2.5 text-sm font-semibold text-stone-700 transition hover:bg-stone-100 hover:text-stone-950"
				>
					{t("nav.menu")}
				</a>
				<a
					href="#menu"
					class="mt-1 rounded-xl bg-stone-950 px-3 py-2.5 text-center text-sm font-semibold text-white transition hover:bg-orange-700"
				>
					{t("nav.reserve")}
				</a>
				<div class="flex justify-center px-3 pb-1 pt-2">
					<LanguageSwitcher lang={lang} />
				</div>
			</div>
		</details>
	</div>
</header>
