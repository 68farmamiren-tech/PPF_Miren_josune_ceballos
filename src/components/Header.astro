---
import { getRelativeLocaleUrl } from "astro:i18n";
import LanguageSwitcher from "./LanguageSwitcher.astro";
import { useTranslations } from "../i18n/utils.ts";

interface Props {
	lang: "es" | "en";
}

const { lang } = Astro.props;
const t = useTranslations(lang);

const homeUrl = getRelativeLocaleUrl(lang, "/");
---

<header class="w-full border-b border-stone-200 bg-white/90 backdrop-blur">
	<div class="mx-auto flex w-full max-w-6xl items-center justify-between gap-4 px-6 py-4">
		<a
			href={homeUrl}
			class="text-base font-bold tracking-tight text-stone-900 transition hover:text-orange-700"
		>
			Casa Tomate
		</a>

		<nav class="hidden items-center gap-6 md:flex">
			<a
				href={homeUrl}
				class="text-sm font-medium text-stone-600 transition hover:text-stone-900"
			>
				{t("nav.home")}
			</a>
			<a
				href="#info"
				class="text-sm font-medium text-stone-600 transition hover:text-stone-900"
			>
				{t("nav.about")}
			</a>
			<a
				href="#menu"
				class="text-sm font-medium text-stone-600 transition hover:text-stone-900"
			>
				{t("nav.menu")}
			</a>
			<LanguageSwitcher lang={lang} />
		</nav>

		<details class="relative md:hidden">
			<summary
				class="inline-flex cursor-pointer list-none items-center justify-center rounded-full border border-stone-300 p-2 text-stone-700 transition hover:border-stone-400 hover:bg-stone-50 [&::-webkit-details-marker]:hidden"
			>
				<span class="sr-only">{t("nav.openMenu")}</span>
				<svg
					xmlns="http://www.w3.org/2000/svg"
					width="20"
					height="20"
					viewBox="0 0 24 24"
					fill="none"
					stroke="currentColor"
					stroke-width="2"
					stroke-linecap="round"
					stroke-linejoin="round"
					aria-hidden="true"
				>
					<line x1="4" x2="20" y1="6" y2="6"></line>
					<line x1="4" x2="20" y1="12" y2="12"></line>
					<line x1="4" x2="20" y1="18" y2="18"></line>
				</svg>
			</summary>
			<div class="absolute right-0 top-full z-50 mt-2 flex w-52 flex-col gap-1 rounded-2xl border border-stone-200 bg-white p-3 shadow-xl shadow-stone-900/5">
				<a
					href={homeUrl}
					class="rounded-lg px-3 py-2 text-sm font-medium text-stone-700 transition hover:bg-stone-100 hover:text-stone-900"
				>
					{t("nav.home")}
				</a>
				<a
					href="#info"
					class="rounded-lg px-3 py-2 text-sm font-medium text-stone-700 transition hover:bg-stone-100 hover:text-stone-900"
				>
					{t("nav.about")}
				</a>
				<a
					href="#menu"
					class="rounded-lg px-3 py-2 text-sm font-medium text-stone-700 transition hover:bg-stone-100 hover:text-stone-900"
				>
					{t("nav.menu")}
				</a>
				<div class="px-3 py-2">
					<LanguageSwitcher lang={lang} />
				</div>
			</div>
		</details>
	</div>
</header>
