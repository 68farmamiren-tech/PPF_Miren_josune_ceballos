---
import "../styles/global.css";
import { useTranslations } from "../i18n/utils.ts";

interface Props {
	title?: string;
	description?: string;
	lang?: string;
}

const {
	title = "Restaurante — Landing page con Astro",
	description = "Landing page responsive de ejemplo para un restaurante, construida con Astro y Tailwind CSS 4.",
	lang = Astro.currentLocale ?? "es",
} = Astro.props;

const t = useTranslations(lang);
---

<!doctype html>
<html lang={lang}>
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<meta name="description" content={description} />
		<meta name="generator" content={Astro.generator} />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<link rel="icon" href="/favicon.ico" />
		<title>{title}</title>
	</head>
	<body>
		<a
			href="#main"
			class="sr-only focus:not-sr-only focus:absolute focus:left-4 focus:top-4 focus:z-[60] focus:rounded-full focus:bg-stone-950 focus:px-5 focus:py-2.5 focus:text-sm focus:font-bold focus:text-white"
		>
			{t("nav.skip")}
		</a>
		<slot />
	</body>
</html>
