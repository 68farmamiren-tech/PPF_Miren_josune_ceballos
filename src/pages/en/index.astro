---
import Layout from "../../layouts/Layout.astro";
import Header from "../../components/Header.astro";
import Hero from "../../components/Hero.astro";
import FlexibleMenu from "../../components/FlexibleMenu.astro";
import VisualEditing from "../../components/VisualEditing.astro";
import LightningFast from "../../components/LightningFast.astro";
import DocsFeatures from "../../components/DocsFeatures.astro";
import OpenSource from "../../components/OpenSource.astro";
import TastyDeals from "../../components/TastyDeals.astro";
import Footer from "../../components/Footer.astro";
import { ui } from "../../i18n/ui.ts";
---

<Layout lang="en" title={ui.en.meta.title} description={ui.en.meta.description}>
	<Header lang="en" />
	<main id="main">
		<Hero lang="en" />
		<FlexibleMenu lang="en" />
		<VisualEditing lang="en" />
		<LightningFast lang="en" />
		<DocsFeatures lang="en" />
		<OpenSource lang="en" />
		<TastyDeals lang="en" />
	</main>
	<Footer lang="en" />
</Layout>
