---
import Layout from "../../layouts/Layout.astro";
import Header from "../../components/Header.astro";
import Hero from "../../components/Hero.astro";
import FlexibleMenu from "../../components/FlexibleMenu.astro";
import VisualEditing from "../../components/VisualEditing.astro";
import LightningFast from "../../components/LightningFast.astro";
import DocsFeatures from "../../components/DocsFeatures.astro";
import OpenSource from "../../components/OpenSource.astro";
import TastyDeals from "../../components/TastyDeals.astro";
import Footer from "../../components/Footer.astro";
import { ui } from "../../i18n/ui.ts";
---

<Layout lang="es" title={ui.es.meta.title} description={ui.es.meta.description}>
	<Header lang="es" />
	<main id="main">
		<Hero lang="es" />
		<FlexibleMenu lang="es" />
		<VisualEditing lang="es" />
		<LightningFast lang="es" />
		<DocsFeatures lang="es" />
		<OpenSource lang="es" />
		<TastyDeals lang="es" />
	</main>
	<Footer lang="es" />
</Layout>
